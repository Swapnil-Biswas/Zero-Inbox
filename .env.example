# Zero-Inbox Configuration

# Server
ZERO_INBOX_HOST=0.0.0.0
ZERO_INBOX_PORT=8010
ZERO_INBOX_ENV=development
ZERO_INBOX_LOG_LEVEL=INFO
ZERO_INBOX_SECRET_KEY=change-me-to-a-secure-random-key

# Database
ZERO_INBOX_DB_PATH=./data/zero_inbox.db

# LLM Providers (Configure at least one or use fallback local mode)
DEFAULT_LLM_PROVIDER=local_fallback  # gemini | openai | anthropic | local | local_fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_ENDPOINT=http://localhost:11434/v1

# Autonomous Scheduling
DEFAULT_SCHEDULE_HOUR=6
DEFAULT_SCHEDULE_MINUTE=0
DEFAULT_TIMEZONE=UTC

# Delivery Channels
# Telegram
TELEGRAM_BOT_TOKEN=
# Discord
DISCORD_WEBHOOK_URL=
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=daily_media_digest

# MCP Server
ZERO_INBOX_MCP_AUTH_TOKEN=

# HireCrew Marketplace Integration
# Token issued by HireCrew after review. Leave unset locally: a random token then keeps /jobs closed.
HIRECREW_SELLER_TOKEN=

# Research LLM used for HireCrew briefs (OpenAI-compatible chat API)
RESEARCH_LLM_ENDPOINT=http://localhost:1234/v1
RESEARCH_LLM_MODEL=google/gemma-4-e2b
RESEARCH_LLM_API_KEY=
RESEARCH_EVIDENCE_CHAR_BUDGET=12000

